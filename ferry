#!/usr/bin/env python3
"""ferry: move files between this Mac and a home server.

Transport is rsync over SSH with the key you already use, so there is no new
port, daemon, or password. Every transfer is checked end to end with sha256.
"""
import argparse
import inspect
import json
import os
import posixpath
import shlex
import subprocess
import sys
import time

HOST = os.environ.get("FERRY_HOST", "homelab")
# Remote relative paths resolve here; ssh starts in the remote home directory.
EXCHANGE = "Ferry"
SSH = [
    "ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
    "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=4",
]
RSYNC = [
    "rsync", "-a", "--exclude=.DS_Store", "-e", " ".join(SSH),
]


def manifest(paths):
    # Runs locally and, via its source text, on the remote, so stdlib only.
    import hashlib, os

    def digest(path):
        if os.path.islink(path):
            return "link:" + os.readlink(path)
        if os.path.isdir(path):
            return "dir"
        h = hashlib.sha256()
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                h.update(chunk)
        return h.hexdigest()

    result = {}
    for top in paths:
        if not os.path.lexists(top):
            result[top] = None
            continue
        entries = {".": digest(top)}
        if os.path.isdir(top) and not os.path.islink(top):
            for root, dirs, files in os.walk(top):
                for name in dirs + files:
                    if name != ".DS_Store":
                        full = os.path.join(root, name)
                        entries[os.path.relpath(full, top)] = digest(full)
        result[top] = entries
    return result


def die(msg):
    print("ferry: " + msg, file=sys.stderr)
    sys.exit(1)


def remote_path(p):
    if p == "~":
        return "."
    if p.startswith("~/"):
        return p[2:]
    if p.startswith("/"):
        return p
    return posixpath.normpath(posixpath.join(EXCHANGE, p))


def display(rpath):
    return "%s:%s" % (HOST, rpath if rpath.startswith("/") else "~/" + rpath)


def ssh(command, check=True):
    proc = subprocess.run(SSH + [HOST, command], stdout=subprocess.PIPE, universal_newlines=True)
    if check and proc.returncode != 0:
        die("ssh %s failed (exit %d)" % (HOST, proc.returncode))
    return proc


def remote_manifest(paths):
    code = inspect.getsource(manifest) + "\nimport json, sys\nprint(json.dumps(manifest(json.loads(sys.argv[1]))))"
    out = ssh("python3 -c %s %s" % (shlex.quote(code), shlex.quote(json.dumps(paths)))).stdout
    return json.loads(out)


def rsync(sources, dest, checksum=False):
    cmd = RSYNC + (["--checksum"] if checksum else []) + (["--progress"] if sys.stdout.isatty() else [])
    rc = subprocess.call(cmd + sources + [dest])
    if rc != 0:
        die("rsync exited %d" % rc)


def mismatches(expected, actual):
    bad = []
    for top, entries in expected.items():
        got = actual.get(top) or {}
        bad += [os.path.normpath(os.path.join(top, rel)) for rel, h in entries.items() if got.get(rel) != h]
    return bad


def transfer(sources, dest, pairs, source_manifest, dest_manifest):
    """pairs maps each source manifest key to where it lands in the dest manifest."""
    expected = {pairs[k]: v for k, v in source_manifest.items()}
    started = time.time()
    rsync(sources, dest)
    bad = mismatches(expected, dest_manifest(list(expected)))
    if bad:
        # rsync skips files whose size and mtime already match, so compare content.
        print("ferry: %d file(s) differ after transfer, recopying by checksum" % len(bad), file=sys.stderr)
        rsync(sources, dest, checksum=True)
        bad = mismatches(expected, dest_manifest(list(expected)))
        if bad:
            die("sha256 mismatch after retry:\n  " + "\n  ".join(bad))
    files = sum(1 for v in expected.values() for h in v.values() if h != "dir" and not h.startswith("link:"))
    return files, time.time() - started


def local_bytes(paths):
    total = 0
    for top in paths:
        if os.path.isfile(top):
            total += os.path.getsize(top)
        for root, _, files in os.walk(top):
            total += sum(os.lstat(os.path.join(root, f)).st_size for f in files)
    return total


def summary(verb, files, nbytes, seconds, landed):
    mb = nbytes / 1e6
    print("ferry: %s %d file(s), %.1f MB in %.1fs (%.1f MB/s), sha256 verified" % (verb, files, mb, seconds, mb / max(seconds, 0.001)))
    for path in landed:
        print("  " + path)


def send(args):
    sources = [os.path.abspath(p) for p in args.paths]
    missing = [p for p in sources if not os.path.lexists(p)]
    if missing:
        die("no such file: " + ", ".join(missing))
    rdir = remote_path(args.to or "")
    ssh("mkdir -p -- %s" % shlex.quote(rdir))
    pairs = {s: posixpath.join(rdir, os.path.basename(s)) for s in sources}
    files, seconds = transfer(
        sources, "%s:%s" % (HOST, shlex.quote(rdir + "/")), pairs, manifest(sources), remote_manifest
    )
    summary("sent", files, local_bytes(sources), seconds, [display(p) for p in pairs.values()])


def get(args):
    rsources = [remote_path(p) for p in args.paths]
    for p in rsources:
        if posixpath.basename(p) in ("", ".", ".."):
            die("name a file or folder, not %r" % p)
    found = remote_manifest(rsources)
    missing = [display(p) for p, m in found.items() if m is None]
    if missing:
        die("no such remote file: " + ", ".join(missing))
    ldir = os.path.abspath(os.path.expanduser(args.to or "."))
    os.makedirs(ldir, exist_ok=True)
    pairs = {p: os.path.join(ldir, posixpath.basename(p)) for p in rsources}
    files, seconds = transfer(
        ["%s:%s" % (HOST, shlex.quote(p)) for p in rsources], ldir + "/", pairs, found, manifest
    )
    summary("received", files, local_bytes(list(pairs.values())), seconds, list(pairs.values()))


def ls(args):
    rpath = remote_path(args.path or "")
    setup = "mkdir -p %s && " % EXCHANGE if rpath == EXCHANGE else ""
    proc = ssh(setup + "ls -lhA -- %s" % shlex.quote(rpath), check=False)
    print(proc.stdout, end="")
    sys.exit(proc.returncode)


def main():
    parser = argparse.ArgumentParser(
        prog="ferry",
        description="Move files to and from %s. Remote relative paths are under ~/%s; "
        "use ~/... or /... for anywhere else." % (HOST, EXCHANGE),
    )
    sub = parser.add_subparsers(dest="cmd", metavar="{send,get,ls}")
    sub.required = True
    p = sub.add_parser("send", help="copy local files or folders to the homelab")
    p.add_argument("paths", nargs="+")
    p.add_argument("-t", "--to", help="remote folder (default ~/%s)" % EXCHANGE)
    p.set_defaults(func=send)
    p = sub.add_parser("get", help="copy remote files or folders here")
    p.add_argument("paths", nargs="+")
    p.add_argument("-t", "--to", help="local folder (default: current directory)")
    p.set_defaults(func=get)
    p = sub.add_parser("ls", help="list a remote folder (default ~/%s)" % EXCHANGE)
    p.add_argument("path", nargs="?")
    p.set_defaults(func=ls)
    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
